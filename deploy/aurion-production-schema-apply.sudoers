# The deployment account may invoke only the fixed, root-owned schema apply
# entrypoint. It cannot choose arbitrary code, Docker arguments, backups, or
# environment files.
aurion-deploy ALL=(root) NOPASSWD: /usr/local/sbin/aurion-production-schema-apply *

# The post-promotion workflow may attest the fixed, root-owned manifest only.
# It receives no general shell, Docker, or caller-controlled filesystem access.
aurion-deploy ALL=(root) NOPASSWD: /usr/bin/test -f /opt/echoes-of-aurion-schema-apply/current/manifest.json
aurion-deploy ALL=(root) NOPASSWD: /usr/bin/grep -Fq * /opt/echoes-of-aurion-schema-apply/current/manifest.json
