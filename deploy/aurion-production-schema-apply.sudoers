# The deployment account may invoke only the fixed, root-owned schema apply
# entrypoint. It cannot choose arbitrary code, Docker arguments, backups, or
# environment files.
aurion-deploy ALL=(root) NOPASSWD: /usr/local/sbin/aurion-production-schema-apply *

# The post-promotion workflow may attest only one canonical 40-hex revision
# against this fixed root-owned manifest. Character classes exclude whitespace,
# so the argument pattern cannot absorb a second option, argument, or path.
aurion-deploy ALL=(root) NOPASSWD: /usr/bin/test -f /opt/echoes-of-aurion-schema-apply/current/manifest.json
aurion-deploy ALL=(root) NOPASSWD: /usr/bin/grep -Fq [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f] /opt/echoes-of-aurion-schema-apply/current/manifest.json
