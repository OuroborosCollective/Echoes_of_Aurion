#!/usr/bin/env bash
# aurion-glb-backfill-wrapper: the only Docker surface granted to the production
# GLB normalization workflow. Keep this file root-owned and mode 0755 after install.
set -euo pipefail

readonly CONTAINER="echoes-of-aurion-aurion-1"
readonly UTILITY="/tmp/aurion-glb-normalization-backfill.mjs"

fail() {
  printf '%s\n' "$1" >&2
  exit 64
}

command_name="${1:-}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$command_name" in
  inspect-running)
    (($# == 0)) || fail "GLB_BACKFILL_ARGUMENTS"
    exec docker inspect --format '{{.State.Running}}' "$CONTAINER"
    ;;
  inspect-revision)
    (($# == 0)) || fail "GLB_BACKFILL_ARGUMENTS"
    exec docker inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$CONTAINER"
    ;;
  inspect-storage-env)
    (($# == 0)) || fail "GLB_BACKFILL_ARGUMENTS"
    exec docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$CONTAINER"
    ;;
  inspect-volume)
    (($# == 0)) || fail "GLB_BACKFILL_ARGUMENTS"
    exec docker inspect --format '{{range .Mounts}}{{println .Name ":" .Destination}}{{end}}' "$CONTAINER"
    ;;
  inspect-release-sha)
    (($# == 0)) || fail "GLB_BACKFILL_ARGUMENTS"
    exec docker exec "$CONTAINER" printenv AURION_RELEASE_SHA
    ;;
  copy-utility)
    (($# == 0)) || fail "GLB_BACKFILL_ARGUMENTS"
    # Read the bundle from stdin; never accept an arbitrary source or destination.
    exec docker exec -i "$CONTAINER" sh -ceu \
      'cat > "$1" && chmod 0755 "$1"' sh "$UTILITY"
    ;;
  run)
    (($# == 2)) || fail "GLB_BACKFILL_ARGUMENTS"
    mode="$1"
    expected="$2"
    [[ "$mode" == audit || "$mode" == apply || "$mode" == readback ]] || fail "GLB_BACKFILL_MODE"
    [[ "$expected" =~ ^(0|[1-9][0-9]*)$ ]] || fail "GLB_BACKFILL_COUNT"
    exec docker exec "$CONTAINER" node "$UTILITY" \
      --mode "$mode" --expected-missing-count "$expected"
    ;;
  cleanup)
    (($# == 0)) || fail "GLB_BACKFILL_ARGUMENTS"
    exec docker exec "$CONTAINER" rm -f "$UTILITY"
    ;;
  *)
    fail "GLB_BACKFILL_COMMAND"
    ;;
esac
