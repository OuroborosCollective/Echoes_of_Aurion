    backup:{created:true,id:process.env.APPLY_BACKUP_BASENAME,sha256:process.env.APPLY_BACKUP_SHA256,bytes:Number(process.env.APPLY_BACKUP_BYTES)},
    recovery:{executed:true,databaseImageId:process.env.APPLY_DATABASE_IMAGE_ID,sourceTableCount:Number(process.env.APPLY_SOURCE_TABLE_COUNT),recoveryTableCount:Number(process.env.APPLY_RECOVERY_TABLE_COUNT),schemaSha256:process.env.APPLY_SCHEMA_SHA256,matched:true},
    apply:{state:execution.state,appliedMigrationTags:execution.appliedMigrationTags},
    postflight:{state:postflight.overallState,summary:postflight.summary},
  },null,2)}\n`,{mode:0o600});
' "$success_tmp"
persist_receipt "$success_tmp"
rm -f "$success_tmp" "$preflight_raw" "$postflight_raw" "$apply_raw"
exit 0
