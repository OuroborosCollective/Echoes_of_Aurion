# Installed as /etc/aurion-revision-alignment/controller.env (root:root, 0640).
AURION_RECONCILER_REPOSITORY=OuroborosCollective/Echoes_of_Aurion
AURION_RECONCILER_WORKFLOW=deploy-aurion-zone-runtime.yml
AURION_RECONCILER_BRANCH=main
AURION_RECONCILER_HEALTH_URL=https://arelogic.space/healthz
AURION_RECONCILER_STATE_DIR=/var/lib/aurion-revision-alignment
