[Unit]
Description=Aurion committed-world projection for Godot
After=network.target docker.service

[Service]
Type=simple
User=aurion-deploy
Group=aurion-deploy
WorkingDirectory=/srv/serverin/tools/aurion-godot-bridge/current
EnvironmentFile=/etc/aurion-godot-bridge.env
LoadCredential=aurion-upstream:/etc/aurion-godot/feed.token
LoadCredential=aurion-editor:/etc/aurion-godot/editor.token
Environment=UPSTREAM_TOKEN_FILE=%d/aurion-upstream
Environment=BRIDGE_TOKEN_FILE=%d/aurion-editor
ExecStart=/usr/bin/node /srv/serverin/tools/aurion-godot-bridge/current/aurion-godot-bridge.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/serverin/evidence/aurion-godot-bridge

[Install]
WantedBy=multi-user.target

