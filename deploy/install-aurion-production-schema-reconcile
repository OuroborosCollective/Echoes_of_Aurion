#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 2 || $# -gt 3 ]]; then
  echo "usage: install-aurion-production-schema-reconcile <artifact-dir> <expected-sha40> [--enable-runner]" >&2
  exit 64
fi
if [[ "${EUID}" -ne 0 ]]; then
  echo "installer must run as root" >&2
  exit 77
fi

artifact_dir="$(readlink -f "$1")"
expected_sha="$2"
enable_runner="${3:-}"
[[ "$expected_sha" =~ ^[a-f0-9]{40}$ ]] || { echo "invalid expected revision" >&2; exit 64; }
[[ -d "$artifact_dir" ]] || { echo "artifact directory missing" >&2; exit 66; }
[[ -f "${artifact_dir}/manifest.json" && -f "${artifact_dir}/checksums.sha256" ]] || { echo "artifact metadata missing" >&2; exit 66; }
[[ -f "${artifact_dir}/deploy/aurion-production-schema-reconcile" ]] || { echo "root runner missing from artifact" >&2; exit 66; }

manifest_revision="$(node --input-type=module -e 'import fs from "node:fs"; const m=JSON.parse(fs.readFileSync(process.argv[1],"utf8")); if(m.schemaVersion!==1||m.recordType!=="aurion_production_schema_reconcile_artifact"||m.mode!=="read_only"||!/^([a-f0-9]{40})$/.test(m.revision)){process.exit(2)}; process.stdout.write(m.revision)' "${artifact_dir}/manifest.json")"
[[ "$manifest_revision" == "$expected_sha" ]] || { echo "artifact revision mismatch" >&2; exit 70; }
(
  cd "$artifact_dir"
  sha256sum --strict -c checksums.sha256 >/dev/null
)

base=/opt/echoes-of-aurion-schema-reconcile
release="${base}/releases/${expected_sha}"
install -d -o root -g root -m 0755 "${base}/releases"
if [[ -e "$release" ]]; then
  [[ -d "$release" && -f "${release}/manifest.json" && -f "${release}/checksums.sha256" ]] || { echo "existing release is incomplete" >&2; exit 73; }
  (
    cd "$release"
    sha256sum --strict -c checksums.sha256 >/dev/null
  )
else
  install -d -o root -g root -m 0755 "$release"
  cp -a "${artifact_dir}/." "$release/"
  chown -R root:root "$release"
  find "$release" -type d -exec chmod 0755 {} +
  find "$release" -type f -exec chmod 0644 {} +
  chmod 0755 "${release}/bin/reconcile.mjs" "${release}/deploy/aurion-production-schema-reconcile"
fi

ln -sTfn "$release" "${base}/current.next"
mv -Tf "${base}/current.next" "${base}/current"
[[ "$(readlink -f "${base}/current")" == "$release" ]]

install -o root -g root -m 0755 "${release}/deploy/aurion-production-schema-reconcile" /usr/local/sbin/aurion-production-schema-reconcile

if [[ "$enable_runner" == "--enable-runner" ]]; then
  [[ -f "${release}/deploy/aurion-production-schema-reconcile.sudoers" ]] || { echo "sudoers policy missing from artifact" >&2; exit 66; }
  install -o root -g root -m 0440 "${release}/deploy/aurion-production-schema-reconcile.sudoers" /etc/sudoers.d/aurion-production-schema-reconcile
  visudo -cf /etc/sudoers.d/aurion-production-schema-reconcile >/dev/null
elif [[ -n "$enable_runner" ]]; then
  echo "unknown installer option" >&2
  exit 64
fi

printf '{"installed":true,"revision":"%s","runnerEnabled":%s}\n' "$expected_sha" "$([[ "$enable_runner" == "--enable-runner" ]] && echo true || echo false)"
