# Public HTTPS route of the existing Aurion tRPC backend. No database password,
# MCP credential or private provider key belongs in this file.
AURION_TICKET_CONSUME_URL=https://aurion3d-6hpapr2g.manus.space/api/trpc

# Must equal the exact Git revision bundled into the active release directory.
AURION_RUNTIME_REVISION=replace-with-sha40

# Companion learning memory: local append-only storage is always used.
COMPANION_MEMORY_DIR=./data/companion-memory
# Optional trusted VPS Redis database; never expose this URL to the browser.
# REDIS_URL=redis://127.0.0.1:6379/2

# Milvus can be added later as a separate embedding index; raw frames are not replicated by this adapter.
# MILVUS_ADDRESS=127.0.0.1:19530
# MILVUS_COLLECTION=aurion_companion_memory_v1
