            "sourceRevision": self.REVISION,
            "readOnly": True,
            "databaseCredentialReturned": False,
            "overallState": "RECONCILIATION_REQUIRED",
        }, self.REVISION)

    def plan_receipt(self):
        source_ledger = make_wasd_source_ledger()
