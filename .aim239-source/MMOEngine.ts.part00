interface ActiveProjectile {
  mesh: THREE.Mesh;
  startPos: THREE.Vector3;
  targetPos: THREE.Vector3;
  progress: number;
  speed: number;
  damage: number;
  isCrit: boolean;
  targetMobId: string;
  color: string;
}

interface ActiveAoEEffect {
  mesh: THREE.Mesh;
  timer: number;
  maxTimer: number;
}

