; Aurion client presentation. Canonical simulation remains on the Aurion server.
config_version=5

[editor_plugins]
enabled=PackedStringArray("res://addons/aurion_android_app_link/plugin.cfg", "res://addons/aurion_knowledge_helper/plugin.cfg")

[application]
config/name="Echoes of Aurion"
config/icon="res://assets/icon.svg"
config/version="0.1.0"
run/main_scene="res://app/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="disabled"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.045, 0.065, 1)

[input]
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]}
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]}
move_backward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
primary_action={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}

[aurion]
server_base_url="https://arelogic.space"
client_build="aurion-godot-g06-dev"
renderer_profile="compatibility"
native_auth_start_enabled=false

